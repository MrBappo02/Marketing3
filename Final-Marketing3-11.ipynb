   "source": [
    "# Evaluate under the 12% contact capacity: contact the 12% customers with the highest score\n",
    "k = int(round(CAPACITY * len(y)))\n",
    "print(\"Customers that can be contacted:\", k, \"of\", len(y))\n",
    "\n",
    "def select_top(score):\n",
    "    \"\"\"1 = contact (top 12% by score), 0 = not contacted\"\"\"\n",
    "    selected = np.zeros(len(score), dtype=int)\n",
    "    selected[np.argsort(-np.asarray(score), kind=\"stable\")[:k]] = 1\n",
    "    return selected\n",
    "\n",
    "def evaluate(name, selected):\n",
    "    return {\"model\": name,\n",
    "            \"contacted\": selected.sum(),\n",
    "            \"converters_reached\": int(((selected == 1) & (y == 1)).sum()),\n",
    "            \"precision\": precision_score(y, selected),\n",
    "            \"recall\": recall_score(y, selected),\n",
    "            \"f1\": f1_score(y, selected),\n",
    "            \"accuracy\": accuracy_score(y, selected)}\n",
    "\n",
    "# Baseline 1 - random 12% (average of 200 random selections = what a campaign without targeting gets)\n",
    "random_runs = pd.DataFrame([evaluate(\"random\", select_top(np.random.default_rng(s).random(len(y)))) for s in range(200)])\n",
    "\n",
    "# Baseline 2 - simple CRM rule: contact the most recent buyers first\n",
    "sel_recency = select_top(-df[\"days_since_last_order\"])\n",
    "\n",
    "# Candidate - logistic regression probabilities from 5-fold CV\n",
    "proba = cross_val_predict(LogisticRegression(), X, y, cv=5, method=\"predict_proba\")[:, 1]\n",
    "sel_logreg = select_top(proba)\n",
    "\n",
    "results = pd.DataFrame([\n",
    "    {\"model\": \"B0 naive (nobody)\", \"contacted\": 0, \"converters_reached\": 0, \"precision\": 0, \"recall\": 0, \"f1\": 0,\n",
    "     \"accuracy\": accuracy_score(y, y_naive)},\n",
    "    {**random_runs.drop(columns=\"model\").mean().to_dict(), \"model\": \"B1 random 12%\"},\n",
    "    evaluate(\"B2 recency rule\", sel_recency),\n",
    "    evaluate(\"Logistic regression\", sel_logreg),\n",
    "]).set_index(\"model\")\n",
    "results[\"lift_vs_base_rate\"] = results[\"precision\"] / y.mean()\n",
    "results.round(3)"
   ]
  },
