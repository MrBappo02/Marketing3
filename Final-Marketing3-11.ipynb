    "\n",
    "columns = X.columns\n",
    "scaler = MinMaxScaler()\n",
    "X = scaler.fit_transform(X)\n",
    "X = pd.DataFrame(X, columns=columns)\n",
    "\n",
    "print(\"X shape:\", X.shape, \"| missing values in X:\", X.isna().sum().sum())\n",
    "X.describe().T[[\"min\", \"max\", \"mean\"]].round(2)"
   ]
