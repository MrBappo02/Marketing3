    "# D5 - Feature selection: exclude leakage and identifiers (feature EXCLUSION decision)\n",
    "# Evidence that it matters: same logistic regression, 5-fold CV, with and without the post-campaign click column\n",
    "def cv_scores(feature_cols):\n",
    "    data = df.dropna(subset=[\"avg_basket_eur_12m\"])\n",
    "    X = pd.get_dummies(data[feature_cols], drop_first=True)\n",
    "    X = pd.DataFrame(MinMaxScaler().fit_transform(X), columns=X.columns)\n",
    "    y = data[\"conversion_flag\"].values\n",
    "    proba = cross_val_predict(LogisticRegression(), X, y, cv=5, method=\"predict_proba\")[:, 1]\n",
    "    k = int(round(CAPACITY * len(y)))\n",
    "    top = np.argsort(-proba)[:k]\n",
    "    return y[top].mean()\n",
    "\n",
    "pre_campaign = [\"previous_orders_12m\", \"days_since_last_order\", \"avg_basket_eur_12m\",\n",
    "                \"loyalty_tier\", \"channel\", \"discount_pct\"]\n",
    "print(f\"Precision in top 12% - pre-campaign features only:       {cv_scores(pre_campaign):.2%}\")\n",
    "print(f\"Precision in top 12% - plus clicks_after_campaign (LEAK): {cv_scores(pre_campaign + ['clicks_after_campaign']):.2%}\")\n",
    "\n",
    "excluded = {\"purchase_revenue_after_campaign_eur\": \"post-campaign; > 0 exactly when converted (target leakage)\",\n",
    "            \"clicks_after_campaign\": \"post-campaign; not known when the list is made\",\n",
    "            \"campaign_cost_eur\": \"recorded per contact; used for the business case only\",\n",
    "            \"customer_id\": \"identifier\",\n",
    "            \"campaign_id\": \"identifier; the next campaign has a new id\"}\n",
    "display(pd.DataFrame.from_dict(excluded, orient=\"index\", columns=[\"reason for exclusion\"]))\n",
    "features = pre_campaign\n",
    "print(\"Model features:\", features)"
