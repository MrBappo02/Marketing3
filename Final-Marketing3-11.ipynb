    "# Segment check: who is selected and how well does each segment perform?\n",
    "seg = df[[\"loyalty_tier\", \"channel\", \"campaign_id\", \"days_since_last_order\", \"conversion_flag\"]].copy()\n",
    "seg[\"selected_logreg\"] = sel_logreg\n",
    "seg[\"selected_recency\"] = sel_recency\n",
    "seg[\"recency_band\"] = pd.cut(seg[\"days_since_last_order\"], [0, 90, 180, 270, 365],\n",
    "                             labels=[\"0-90\", \"91-180\", \"181-270\", \"271-365\"])\n",
    "\n",
    "def segment_table(col):\n",
    "    g = seg.groupby(col, observed=True)\n",
    "    out = pd.DataFrame({\n",
    "        \"customers\": g.size(),\n",
    "        \"share_of_base_%\": g.size() / len(seg) * 100,\n",
    "        \"share_of_selected_%\": g[\"selected_logreg\"].sum() / seg[\"selected_logreg\"].sum() * 100,\n",
    "        \"conversion_rate_%\": g[\"conversion_flag\"].mean() * 100,\n",
    "        \"selected\": g[\"selected_logreg\"].sum(),\n",
    "        \"converters_in_selected\": g.apply(lambda d: ((d[\"selected_logreg\"] == 1) & (d[\"conversion_flag\"] == 1)).sum()),\n",
    "    })\n",
    "    out[\"precision_in_selected_%\"] = out[\"converters_in_selected\"] / out[\"selected\"] * 100\n",
    "    return out.round(1)\n",
    "\n",
    "for col in [\"loyalty_tier\", \"channel\", \"recency_band\"]:\n",
    "    print(f\"\\n--- {col} (logistic regression selection) ---\")\n",
    "    display(segment_table(col))"
   ]
