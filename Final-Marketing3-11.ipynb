   "source": [
    "# Conversion rate by recency band (strongest pattern in the boxplots)\n",
    "bands = pd.cut(df_raw[\"days_since_last_order\"], [0, 90, 180, 270, 365],\n",
    "               labels=[\"0-90\", \"91-180\", \"181-270\", \"271-365\"])\n",
    "recency = df_raw.groupby(bands, observed=True).agg(customers=(\"customer_id\", \"count\"),\n",
    "                                                    conversion_rate=(\"conversion_flag\", \"mean\"))\n",
    "recency[\"conversion_rate_pct\"] = recency[\"conversion_rate\"] * 100\n",
    "display(recency.round(3))\n",
    "\n",
    "recency[\"conversion_rate_pct\"].plot(kind=\"bar\")\n",
    "plt.title(\"Conversion rate by days since last order\")\n",
    "plt.xlabel(\"Days since last order\")\n",
    "plt.ylabel(\"Conversion rate (%)\")\n",
    "plt.xticks(rotation=0)\n",
    "plt.show()"
   ]
  },
