   "source": [
    "# Errors in business terms per 1,000 customers (120 contacts)\n",
    "rev_per_converter = df[df[\"conversion_flag\"] == 1][\"purchase_revenue_after_campaign_eur\"].mean()\n",
    "base_rate = y.mean()\n",
    "print(f\"Average revenue per converter: EUR {rev_per_converter:.2f} | cost per contact: EUR {cost_per_contact:.2f}\")\n",
    "\n",
    "rows = []\n",
    "for name in [\"B1 random 12%\", \"B2 recency rule\", \"Logistic regression\"]:\n",
    "    contacts = 1000 * CAPACITY\n",
    "    converters = contacts * results.loc[name, \"precision\"]\n",
    "    rows.append({\"model\": name,\n",
    "                 \"contacts\": contacts,\n",
    "                 \"converters_reached\": round(converters, 1),\n",
    "                 \"wasted_contacts (FP)\": round(contacts - converters, 1),\n",
    "                 \"missed_converters (FN)\": round(1000 * base_rate - converters, 1),\n",
    "                 \"contact_cost_eur\": round(contacts * cost_per_contact),\n",
    "                 \"gross_revenue_eur\": round(converters * rev_per_converter),\n",
    "                 \"break_even_margin\": f\"{contacts * cost_per_contact / (converters * rev_per_converter):.1%}\"})\n",
    "pd.DataFrame(rows).set_index(\"model\")"
   ]
  },
